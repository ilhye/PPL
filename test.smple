}

class Person {
    function initialize(name, age) {
        this.name = name;
        this.age = age;
    }

    function greet() {
        return "Hello, my name is " + this.name + " and I am " + this.age + " years old." .
    }
}

person1 = Person()
person1.initialize("Alice", 30)
display person1.greet()

person2 = Person()
person2.initialize("Bob", 25)
display person2.greet()

display greet.call({name: "Charlie", age: 40})
display greet.call({name: "Dana", age: 35})

function displayGreetings() {
    display person1.greet()
    display person2.greet()
}

displayGreetings()