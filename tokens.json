{
  "Arithmetic":[
    {"token":"ADD", "lexeme":"+"},
    {"token":"SUB", "lexeme":"-"},
    {"token":"MUL", "lexeme":"*"},
    {"token":"DIV", "lexeme":"/"}
  ],
  "whitespace": [
    { "token": "SPACE", "lexeme": "[ ]" },
    { "token": "TAB", "lexeme": "[\t]" },
    { "token": "NEWLINE", "lexeme": "[\n]" }
  ],
  "InOut": [
    { "token": "INPUT", "lexeme": "input" },
    { "token": "OUTPUT", "lexeme": "output" }
  ],
  "identifiers": [
    { "token": "VARIABLE", "lexeme": "[a-zA-Z_][a-zA-Z0-9_]*" },
    { "token": "FUNCTION", "lexeme": "[a-zA-Z_][a-zA-Z0-9_]*" }
  ],
  "datatoken": [
    { "token": "INT", "lexeme": "[0-9]+" },
    { "token": "FLOAT", "lexeme": "[0-9]+\\.[0-9]+" },
    { "token": "STRING", "lexeme": "\"[^\"]*\"" },
    { "token": "BOOL", "lexeme": "true|false" }
  ],
  "delimeters": [
    { "token": "END", "lexeme": "\\." },
    { "token": "PAUSE", "lexeme": "," }
  ],
  "Mismatch": [{ "token": "MISMATCH", "lexeme": "." }],
  "Comments": [
    { "token": "BEGCOMMENT", "lexeme": "/*" },
    { "token": "ENDCOMMENT", "lexeme": "*/" }
  ]
}
